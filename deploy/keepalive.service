[Unit]
Description=Roger keepalive - relaunch a resume-safe trainer if it dies
After=multi-user.target

[Service]
Type=simple
# Set the real paths for your box; nothing is baked into the scripts.
Environment=LOG=%h/.roger/train.log
Environment=PROC=run_train
Environment=LAUNCHER=%h/.roger/launch_train.sh
ExecStart=/bin/bash %h/.roger/keepalive.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
