# Copy to your supervisor environment (systemd user unit Environment= lines,
# a .env read by your process manager, or plain exports before launching).
# NOTHING personal or secret belongs in these files — they are paths and
# thresholds only.

# ── shared ────────────────────────────────────────────────────────────────
ROGER_HOME=/home/YOU/.roger
ROGER_TRAIN_LOG=/home/YOU/.roger/train.log
ROGER_PROC=run_train
ROGER_TMP=/tmp

# ── critic (critic.py) ────────────────────────────────────────────────
ROGER_PERSIST=/tmp/roger_ckpt_persist
ROGER_GATE=85
# schedule the critic recomputes (must match your trainer)
ROGER_LR=5e-5
ROGER_WARMUP=50
ROGER_TOTAL_STEPS=2000
ROGER_END_LR=5e-8
# safety thresholds
ROGER_VRAM_MAX=11.5
ROGER_GRAD_MAX=1000
ROGER_AD_MAX=0.15
ROGER_LOG_MAX_AGE=1800

# ── watchdogs ─────────────────────────────────────────────────────────────
ROGER_LAUNCHER=/home/YOU/.roger/launch_train.sh
ROGER_END_BANNER=CONCLU|DONE
ROGER_LOCKFILE=/tmp/roger/.train.lock
ROGER_PYSPY=/home/YOU/.local/bin/py-spy

# ── gpu_cure (host side) ──────────────────────────────────────────────────
ROGER_STALE_S=3600
ROGER_CADENCE_S=2700
ROGER_BENCH_MIN=2.0
ROGER_INTERVAL_S=1200
ROGER_BENCH=/home/YOU/roger-mlops/scripts/cuda_tflops_bench.py
ROGER_BENCH_OUT=/tmp/roger_cudabench.json

# ── safe_io / mirroring (optional) ────────────────────────────────────────
ROGER_MIRROR=
ROGER_MIRROR_VERIFY=1
