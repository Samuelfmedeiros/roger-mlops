# Copy to your supervisor environment (systemd user unit Environment= lines,
# a .env read by your process manager, or plain exports before launching).
# NOTHING personal or secret belongs in these files — they are paths and
# thresholds only.

# ── shared ────────────────────────────────────────────────────────────────
TATU_HOME=/home/YOU/.tatu
TATU_TRAIN_LOG=/home/YOU/.tatu/train.log
TATU_PROC=run_train
TATU_TMP=/tmp

# ── critic (roger_tatu.py) ────────────────────────────────────────────────
TATU_PERSIST=/tmp/tatu_ckpt_persist
TATU_GATE=85
# schedule the critic recomputes (must match your trainer)
TATU_LR=5e-5
TATU_WARMUP=50
TATU_TOTAL_STEPS=2000
TATU_END_LR=5e-8
# safety thresholds
TATU_VRAM_MAX=11.5
TATU_GRAD_MAX=1000
TATU_AD_MAX=0.15
TATU_LOG_MAX_AGE=1800

# ── watchdogs ─────────────────────────────────────────────────────────────
TATU_LAUNCHER=/home/YOU/.tatu/launch_train.sh
TATU_END_BANNER=CONCLU|DONE
TATU_LOCKFILE=/tmp/tatu/.train.lock
TATU_PYSPY=/home/YOU/.local/bin/py-spy

# ── gpu_cure (host side) ──────────────────────────────────────────────────
TATU_STALE_S=3600
TATU_CADENCE_S=2700
TATU_BENCH_MIN=2.0
TATU_INTERVAL_S=1200
TATU_BENCH=/home/YOU/roger-mlops/scripts/cuda_tflops_bench.py
TATU_BENCH_OUT=/tmp/tatu_cudabench.json

# ── safe_io / mirroring (optional) ────────────────────────────────────────
TATU_MIRROR=
TATU_MIRROR_VERIFY=1
